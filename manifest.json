{
  "manifest_version": 3,
  "name": "DeepSeek 网页端 Token 速度计",
  "description": "测量 DeepSeek 网页版的流式输出速度，自动检查官方 V4.1 Flash tokenizer 更新。",
  "version": "1.1.1",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://huggingface.co/*"
  ],
  "background": {
    "service_worker": "update.js"
  }
}
